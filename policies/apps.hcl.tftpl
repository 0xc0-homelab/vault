# The namespace comes from the login's entity alias, set by Vault from the
# service account's token, never by the caller. A grant across namespaces goes
# in the reader's own policy (mariadb.hcl).

path "apps/data/{{identity.entity.aliases.${kubernetes_accessor}.metadata.service_account_namespace}}/*" {
  capabilities = ["read"]
}

# OpenObserve's RUM client token, one per organization: granted to every
# application because it ships in every visitor's JavaScript anyway.
path "apps/data/shared/openobserve-rum" {
  capabilities = ["read"]
}
