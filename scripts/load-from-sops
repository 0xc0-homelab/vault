#!/usr/bin/env python3
"""Load the CI's secrets into Vault from the repos' SOPS files, once.

The move off SOPS (.github#6). The operator runs it from this repo, with the
workspace's sibling repos checked out, over WARP, logged in to Vault with a
token that may write ci/ (`vault login -no-print`), and `mise exec --` for
sops and vault.

Nothing it reads or writes reaches the screen, a shell history, a command line
or the disk: each value goes from `sops decrypt --extract` into memory, and to
`vault kv put` as JSON on stdin. It prints only paths and key counts.
"""

import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
WORKSPACE = os.path.normpath(os.path.join(HERE, "..", ".."))
os.environ.setdefault("VAULT_ADDR", "https://vault.int.0xc0.cc")

INFRA_TOFU = ("infrastructure", "secrets/tofu.sops.yaml")
INFRA_ANSIBLE = ("infrastructure", "secrets/ansible.sops.yaml")
GITHUB_TOFU = (".github", "secrets/tofu.sops.yaml")

# Vault path under ci/ -> {Vault key: (repo, SOPS file, SOPS key)}
SECRETS = {
    "shared/rustfs": {
        "access_key_id": (*INFRA_TOFU, "AWS_ACCESS_KEY_ID"),
        "secret_access_key": (*INFRA_TOFU, "AWS_SECRET_ACCESS_KEY"),
    },
    "shared/cloudflare": {
        "api_token": (*INFRA_TOFU, "CLOUDFLARE_API_TOKEN"),
    },
    "github/org-app": {
        "app_id": (*GITHUB_TOFU, "TF_VAR_github_app_id"),
        "installation_id": (*GITHUB_TOFU, "TF_VAR_github_app_installation_id"),
        "private_key": (*GITHUB_TOFU, "TF_VAR_github_app_private_key"),
    },
    "infrastructure/proxmox": {
        "endpoint": (*INFRA_TOFU, "PROXMOX_VE_ENDPOINT"),
        "api_token": (*INFRA_TOFU, "PROXMOX_VE_API_TOKEN"),
    },
    "infrastructure/warp": {
        "allowed_emails": (*INFRA_TOFU, "TF_VAR_warp_allowed_emails"),
    },
    "infrastructure/ssh": {
        "private_key": (*INFRA_ANSIBLE, "ci_ssh_private_key"),
    },
    "infrastructure/runner-app": {
        "private_key": (*INFRA_ANSIBLE, "github_runner_app_private_key"),
    },
    "infrastructure/rke2": {
        "token": (*INFRA_ANSIBLE, "rke2_token"),
    },
    "infrastructure/argocd": {
        "admin_password": (*INFRA_ANSIBLE, "argocd_admin_password"),
        "admin_password_bcrypt": (*INFRA_ANSIBLE, "argocd_admin_password_bcrypt"),
    },
    "infrastructure/crowdsec": {
        "bouncer_key": (*INFRA_ANSIBLE, "crowdsec_bouncer_key"),
        "lapi_secret": (*INFRA_ANSIBLE, "crowdsec_lapi_secret"),
        "registration_token": (*INFRA_ANSIBLE, "crowdsec_registration_token"),
    },
    "infrastructure/ui-basic-auth": {
        "password": (*INFRA_ANSIBLE, "ui_basic_auth_password"),
        "users": (*INFRA_ANSIBLE, "ui_basic_auth_users"),
    },
}


def sops_value(repo, path, key):
    return subprocess.run(
        ["sops", "decrypt", "--extract", f'["{key}"]', path],
        cwd=os.path.join(WORKSPACE, repo),
        check=True,
        capture_output=True,
        text=True,
    ).stdout


def vault(*args, stdin=None):
    subprocess.run(
        ["vault", *args],
        input=stdin,
        check=True,
        stdout=subprocess.DEVNULL,
        text=True,
    )


def main():
    try:
        vault("token", "lookup")
    except subprocess.CalledProcessError:
        sys.exit("not logged in to Vault: vault login -no-print")

    for path, keys in SECRETS.items():
        data = {vkey: sops_value(*src) for vkey, src in keys.items()}
        vault("kv", "put", "-mount=ci", path, "-", stdin=json.dumps(data))
        # Not rotated since the bootstrap: the operator rotates each by hand, in Vault.
        vault("kv", "metadata", "put", "-mount=ci",
              "-custom-metadata=owner=operator", "-custom-metadata=rotated_at=bootstrap", path)
        del data
        print(f"ci/{path}: {len(keys)} key(s)")


if __name__ == "__main__":
    main()
